{
  "name": "@pechhe/slipjay",
  "version": "2.0.0",
  "private": true,
  "description": "Harness-neutral JJ workspace and landing tool: one CLI (slipjay) and one library.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:pechhe/slipjay",
  "bin": {
    "slipjay": "src/launcher/workspace.mjs",
    "slipway": "src/launcher/retired-slipway.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/lib/slipjay.d.mts",
      "default": "./src/lib/slipjay.mjs"
    },
    "./delivery": {
      "types": "./src/lib/slipjay.d.mts",
      "default": "./src/lib/slipjay.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "vp lint --quiet && node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test && bun run test:runtimes",
    "test:runtimes": "node --test scripts/check-architecture.test.mjs && bun test scripts/with-hermetic-home.test.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "effect": "4.0.3",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "packageManager": "bun@1.4.3"
}
