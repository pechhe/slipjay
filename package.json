{
  "name": "@pechhe/slipjay",
  "version": "3.43.2",
  "private": true,
  "description": "Harness-neutral JJ workspace and landing tool: one CLI (slipjay) and one library.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:pechhe/slipjay",
  "bin": {
    "slipjay": "src/launcher/workspace.ts"
  },
  "exports": {
    ".": {
      "default": "./src/lib/slipjay.ts"
    },
    "./delivery": {
      "default": "./src/lib/slipjay.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "check": "vp lint --quiet && bun scripts/check-architecture.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test && bun run test:runtimes",
    "test:runtimes": "bun test scripts/check-architecture.test.ts scripts/with-hermetic-home.test.ts scripts/test-landing.test.ts",
    "verify:release": "bun scripts/verify-release.ts",
    "test:landing": "bun scripts/test-landing.ts",
    "test:audit": "bun scripts/test-landing.ts --audit"
  },
  "dependencies": {
    "effect": "4.0.3",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "packageManager": "bun@1.4.3"
}
