{
  "version": 1,
  "tracker": "build",
  "integrationBranch": "main",
  "remote": "origin",
  "requiredLandingVerification": [
    {
      "executable": "bun",
      "args": [
        "install",
        "--frozen-lockfile"
      ],
      "stopOnFailure": true
    },
    {
      "executable": "bun",
      "args": [
        "run",
        "check"
      ],
      "concurrent": true
    },
    {
      "executable": "bun",
      "args": [
        "run",
        "typecheck"
      ],
      "concurrent": true
    },
    {
      "executable": "bun",
      "args": [
        "run",
        "test:landing"
      ],
      "concurrent": true
    }
  ],
  "spares": 4,
  "budgets": {
    "verifyP50Seconds": 90,
    "verifyP90Seconds": 180,
    "testFileSeconds": 30
  },
  "generatedPaths": [
    ".build"
  ],
  "audit": {
    "commands": [
      {
        "executable": "bun",
        "args": [
          "install",
          "--frozen-lockfile"
        ],
        "stopOnFailure": true
      },
      {
        "executable": "bun",
        "args": [
          "run",
          "check"
        ]
      },
      {
        "executable": "bun",
        "args": [
          "run",
          "typecheck"
        ]
      },
      {
        "executable": "bun",
        "args": [
          "run",
          "test:audit"
        ]
      }
    ],
    "timeOfDay": "02:00",
    "timeZone": "Europe/London"
  }
}
